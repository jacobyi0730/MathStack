# ─────────────────────────────────────────────────────────────
# MathStack .gitignore
#
# 원칙: 생성물과 로컬 설정만 제외한다.
#       문서(docs/, Tasks/, mds/)와 팀 설정(.claude/agents, .claude/skills)은
#       이 저장소의 핵심 자산이므로 반드시 커밋한다.
# ─────────────────────────────────────────────────────────────

# ── 의존성 ───────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# package-lock.json 은 커밋한다 (Netlify가 npm ci 로 재현한다)

# ── 빌드 산출물 ──────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# ── 콘텐츠 파이프라인 생성물 ★ ───────────────────────────────
# tools/build-bank.ts 가 굽는 것. content/ 에서 언제든 재생성된다.
# 커밋하면 모든 문항 수정마다 수천 줄 diff 가 딸려온다.
public/data/

# ── 테스트 · 커버리지 ────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── 로그 ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 환경 변수 · 비밀값 ───────────────────────────────────────
.env
.env.*
!.env.example

# ── Netlify 로컬 ─────────────────────────────────────────────
.netlify/

# ── Claude Code ──────────────────────────────────────────────
# agents/ · skills/ · settings.json 은 팀 자산이므로 커밋한다.
# 아래 두 개만 개인 로컬 설정이다.
.claude/settings.local.json
.claude/*.local.json

# ── 에디터 · IDE ─────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS (Windows 개발 환경) ───────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
*.stackdump
.DS_Store

# ── 임시 · 작업 파일 ─────────────────────────────────────────
tmp/
temp/
scratch/
*.tmp
*.bak
*.orig
.codex-out/
