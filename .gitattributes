# 줄바꿈은 저장소에서 항상 LF. Windows 체크아웃 시에만 CRLF 로 변환한다.
* text=auto eol=lf

# 바이너리 — 변환하지 않는다
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary

# 생성물 — diff 를 접어 리뷰 노이즈를 줄인다
public/data/*.json linguist-generated=true
package-lock.json linguist-generated=true
